# Copiar este archivo a ".env" y completar con los valores reales.
# ".env" nunca se sube al repositorio (ver .gitignore).

PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=tp
DB_USER=dsw
DB_PASSWORD=1234

# Secreto usado para firmar los JWT. Usar un valor largo y aleatorio en producción.
JWT_SECRET=cambiar-este-secreto-en-produccion
JWT_EXPIRES_IN=1d
